set diff-highlight = true
set ignore-case = smart-case
set line-graphics = utf-8
set truncation-delimiter = utf-8
set refresh-mode = periodic
set refresh-interval = 1
set main-view-date = relative
set main-view-id-display = yes

color cursor white color34
color cursor-blur white color34 bold

color diff-header yellow color58

color title-focus white color56
color title-blur white color55

source ~/.config/tig/vim.tigrc

bind generic <C-j> next
bind generic <C-k> previous

bind status A !git commit --amend
bind status P !git push
bind status T @trash %(file)
bind status y +sh -c "printf '%s' '%(file)' | wl-copy && echo 'Copied: %(file)'"

bind pager ] move-next-diff
bind pager [ move-prev-diff
bind diff ] move-next-diff
bind diff [ move-prev-diff
