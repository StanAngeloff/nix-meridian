+/*
+ * Annotation marks: scan .git/tig-annotate/ for annotation files and
+ * expose a lookup so draw_view_line() can append a marker to annotated
+ * lines.  The companion tool (tig-annotate-store) stores one file per
+ * annotation, named "{encoded_key}.md": the key is "{path}:{lineno}" for
+ * added and context lines (new-file numbering) and "{path}:-{lineno}"
+ * for deleted lines (old-file numbering), and "/" in the path is
+ * replaced with U+00B7 MIDDLE DOT.  We cache the directory listing and
+ * gate rescans on mtime+ctime so that scrolling costs only one stat().
+ */
+
+#define ANNOTATION_MAX_ENTRIES 4096
+
+static char *annotation_cache[ANNOTATION_MAX_ENTRIES];
+static size_t annotation_cache_count;
+static time_t annotation_last_mtime;
+static time_t annotation_last_ctime;
+
+static void
+annotations_do_scan(const char *path)
+{
+	DIR *dp;
+	struct dirent *ent;
+	size_t i;
+
+	for (i = 0; i < annotation_cache_count; i++)
+		free(annotation_cache[i]);
+	annotation_cache_count = 0;
+
+	dp = opendir(path);
+	if (!dp)
+		return;
+
+	while ((ent = readdir(dp)) != NULL &&
+	       annotation_cache_count < ANNOTATION_MAX_ENTRIES) {
+		const char *name = ent->d_name;
+		size_t len = strlen(name);
+
+		if (len < 4 || strcmp(name + len - 3, ".md") != 0)
+			continue;
+
+		annotation_cache[annotation_cache_count] = strndup(name, len - 3);
+		if (annotation_cache[annotation_cache_count])
+			annotation_cache_count++;
+	}
+
+	closedir(dp);
+}
+
+void
+annotations_scan(void)
+{
+	char path[SIZEOF_STR];
+	struct stat st;
+
+	if (!*repo.git_dir)
+		return;
+
+	if (!string_format(path, "%s/tig-annotate", repo.git_dir))
+		return;
+
+	if (stat(path, &st) != 0) {
+		if (annotation_cache_count > 0) {
+			size_t i;
+
+			for (i = 0; i < annotation_cache_count; i++)
+				free(annotation_cache[i]);
+			annotation_cache_count = 0;
+		}
+		annotation_last_mtime = 0;
+		annotation_last_ctime = 0;
+		return;
+	}
+
+	if (st.st_mtime == annotation_last_mtime &&
+	    st.st_ctime == annotation_last_ctime)
+		return;
+
+	annotation_last_mtime = st.st_mtime;
+	annotation_last_ctime = st.st_ctime;
+	annotations_do_scan(path);
+}
+
+bool
+annotations_exist(void)
+{
+	return annotation_cache_count > 0;
+}
+
+static size_t
+encode_annotation_path(char *dst, size_t dstlen, const char *file)
+{
+	size_t pos = 0;
+	const char *p;
+
+	/* Replace '/' with U+00B7 MIDDLE DOT (UTF-8: C2 B7), matching
+	 * ENCODED_SEPARATOR in tig-annotate-store (store.py). */
+	for (p = file; *p && pos < dstlen - 3; p++) {
+		if (*p == '/') {
+			dst[pos++] = '\xc2';
+			dst[pos++] = '\xb7';
+		} else {
+			dst[pos++] = *p;
+		}
+	}
+	dst[pos] = '\0';
+	return pos;
+}
+
+/*
+ * The old-side path. With diff.mnemonicPrefix, "git diff --cached" and "git diff HEAD" print it as "--- c/{path}"
+ * (object comparisons as "--- o/{path}"), a prefix diff_get_pathname() keeps.
+ * Strip it only when git printed it there: in "--- a/c/{path}" the "c/" is a directory.
+ */
+static const char *
+annotation_old_pathname(struct view *view, struct line *line)
+{
+	const char *file = diff_get_pathname(view, line, true);
+	struct line *header, *old_file;
+	const char *printed;
+
+	if (!file || opt_diff_noprefix)
+		return file;
+
+	header = find_prev_line_in_commit_by_type(view, line, LINE_DIFF_HEADER);
+	old_file = header ? find_next_line_in_diff_by_type(view, header + 1, LINE_DIFF_DEL_FILE) : NULL;
+	if (!old_file)
+		return file;
+
+	printed = box_text(old_file);
+	if (prefixcmp(printed, "--- "))
+		return file;
+	printed += STRING_SIZE("--- ");
+	if (!prefixcmp(printed, "c/") || !prefixcmp(printed, "o/"))
+		return printed + STRING_SIZE("c/");
+	return file;
+}
+
+/*
+ * The unencoded key of an annotatable diff line, as described above.
+ * Returns false for every other line (headers, diffstat, commit message,
+ * "\ No newline at end of file"), so those cannot be annotated.
+ * pager_select() exposes the key as %(annotation) and draw_view_line()
+ * looks marks up with it, so a note and its mark always agree.
+ */
+bool
+annotation_key(struct view *view, struct line *line, char *key, size_t key_size)
+{
+	const char *file;
+	unsigned int file_lineno;
+	bool old;
+
+	switch (line->type) {
+	case LINE_DIFF_ADD:
+	case LINE_DIFF_ADD2:
+	case LINE_DEFAULT:
+		old = false;
+		break;
+	case LINE_DIFF_DEL:
+	case LINE_DIFF_DEL2:
+		old = true;
+		break;
+	default:
+		return false;
+	}
+
+	/* 0 outside a chunk: commit message, diffstat, blank lines. */
+	file_lineno = diff_get_lineno(view, line, old);
+	if (!file_lineno)
+		return false;
+
+	/* A deleted file's new-side name is /dev/null; key it by the old name. */
+	file = diff_get_pathname(view, line, false);
+	if (!file || !strcmp(file, "/dev/null"))
+		file = annotation_old_pathname(view, line);
+	if (!file)
+		return false;
+
+	return string_nformat(key, key_size, NULL, old ? "%s:-%u" : "%s:%u", file, file_lineno);
+}
+
+bool
+annotations_has_key(const char *key)
+{
+	char encoded[SIZEOF_STR];
+	size_t i;
+
+	if (!annotation_cache_count)
+		return false;
+
+	encode_annotation_path(encoded, sizeof(encoded), key);
+
+	for (i = 0; i < annotation_cache_count; i++) {
+		if (strcmp(annotation_cache[i], encoded) == 0)
+			return true;
+	}
+
+	return false;
+}
+
+bool
+annotations_has_file(const char *file)
+{
+	char encoded[SIZEOF_STR];
+	size_t encoded_len;
+	size_t i;
+
+	if (!annotation_cache_count || !file)
+		return false;
+
+	encoded_len = encode_annotation_path(encoded, sizeof(encoded), file);
+
+	for (i = 0; i < annotation_cache_count; i++) {
+		if (strncmp(annotation_cache[i], encoded, encoded_len) == 0 &&
+		    annotation_cache[i][encoded_len] == ':')
+			return true;
+	}
+
+	return false;
+}
