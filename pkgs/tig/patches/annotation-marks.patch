+/*
+ * Annotation marks: scan .git/tig-annotate/ for annotation files and
+ * expose a lookup so draw_view_line() can append a marker to annotated
+ * lines.  The companion shell tool (tig-annotate) stores one file per
+ * annotation, named "{encoded_path}:{lineno}.md" where "/" in the path
+ * is replaced with U+00B7 MIDDLE DOT, and lineno is "file" for
+ * file-level annotations.  We cache the directory listing and gate
+ * rescans on mtime+ctime so that scrolling costs only one stat().
+ */
+
+#define ANNOTATION_MAX_ENTRIES 4096
+
+static char *annotation_cache[ANNOTATION_MAX_ENTRIES];
+static size_t annotation_cache_count;
+static time_t annotation_last_mtime;
+static time_t annotation_last_ctime;
+
+static void
+annotations_do_scan(const char *path)
+{
+	DIR *dp;
+	struct dirent *ent;
+	size_t i;
+
+	for (i = 0; i < annotation_cache_count; i++)
+		free(annotation_cache[i]);
+	annotation_cache_count = 0;
+
+	dp = opendir(path);
+	if (!dp)
+		return;
+
+	while ((ent = readdir(dp)) != NULL &&
+	       annotation_cache_count < ANNOTATION_MAX_ENTRIES) {
+		const char *name = ent->d_name;
+		size_t len = strlen(name);
+
+		if (len < 4 || strcmp(name + len - 3, ".md") != 0)
+			continue;
+
+		annotation_cache[annotation_cache_count] = strndup(name, len - 3);
+		if (annotation_cache[annotation_cache_count])
+			annotation_cache_count++;
+	}
+
+	closedir(dp);
+}
+
+void
+annotations_scan(void)
+{
+	char path[SIZEOF_STR];
+	struct stat st;
+
+	if (!*repo.git_dir)
+		return;
+
+	if (!string_format(path, "%s/tig-annotate", repo.git_dir))
+		return;
+
+	if (stat(path, &st) != 0) {
+		if (annotation_cache_count > 0) {
+			size_t i;
+
+			for (i = 0; i < annotation_cache_count; i++)
+				free(annotation_cache[i]);
+			annotation_cache_count = 0;
+		}
+		annotation_last_mtime = 0;
+		annotation_last_ctime = 0;
+		return;
+	}
+
+	if (st.st_mtime == annotation_last_mtime &&
+	    st.st_ctime == annotation_last_ctime)
+		return;
+
+	annotation_last_mtime = st.st_mtime;
+	annotation_last_ctime = st.st_ctime;
+	annotations_do_scan(path);
+}
+
+bool
+annotations_exist(void)
+{
+	return annotation_cache_count > 0;
+}
+
+static size_t
+encode_annotation_path(char *dst, size_t dstlen, const char *file)
+{
+	size_t pos = 0;
+	const char *p;
+
+	/* Replace '/' with U+00B7 MIDDLE DOT (UTF-8: C2 B7), matching
+	 * the encoding used by the tig-annotate shell script. */
+	for (p = file; *p && pos < dstlen - 3; p++) {
+		if (*p == '/') {
+			dst[pos++] = '\xc2';
+			dst[pos++] = '\xb7';
+		} else {
+			dst[pos++] = *p;
+		}
+	}
+	dst[pos] = '\0';
+	return pos;
+}
+
+bool
+annotations_has(const char *file, unsigned int lineno)
+{
+	char encoded[SIZEOF_STR];
+	char key[SIZEOF_STR];
+	size_t i;
+
+	if (!annotation_cache_count || !file)
+		return false;
+
+	encode_annotation_path(encoded, sizeof(encoded), file);
+
+	if (lineno > 0)
+		string_format(key, "%s:%u", encoded, lineno);
+	else
+		string_format(key, "%s:file", encoded);
+
+	for (i = 0; i < annotation_cache_count; i++) {
+		if (strcmp(annotation_cache[i], key) == 0)
+			return true;
+	}
+
+	return false;
+}
+
+bool
+annotations_has_file(const char *file)
+{
+	char encoded[SIZEOF_STR];
+	size_t encoded_len;
+	size_t i;
+
+	if (!annotation_cache_count || !file)
+		return false;
+
+	encoded_len = encode_annotation_path(encoded, sizeof(encoded), file);
+
+	for (i = 0; i < annotation_cache_count; i++) {
+		if (strncmp(annotation_cache[i], encoded, encoded_len) == 0 &&
+		    annotation_cache[i][encoded_len] == ':')
+			return true;
+	}
+
+	return false;
+}
