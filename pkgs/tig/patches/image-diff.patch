+/* Shows a single-file image diff in the stage view through the kitty graphics protocol.
+ *
+ * The program named by the image-diff-bin option renders both sides into raw RGBA files.
+ * tig asks the terminal to load each file as an image with a virtual placement, then draws the image as text:
+ * every cell is U+10EEEE followed by combining marks for its row, its column and the high byte of the image id,
+ * in a foreground color whose 256-color palette index is the id's low byte.
+ * Because the image is ordinary text, it scrolls with the view and tmux redraws it like any other cell.
+ */
+
+#include "tig/tig.h"
+#include "tig/io.h"
+#include "tig/repo.h"
+#include "tig/options.h"
+#include "tig/display.h"
+#include "tig/draw.h"
+#include "tig/line.h"
+#include "tig/image-diff.h"
