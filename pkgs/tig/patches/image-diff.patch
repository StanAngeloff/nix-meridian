+
+#define IMAGE_MAX_CELLS ((int) ARRAY_SIZE(image_marks))
+
+struct image_panel {
+	bool present;
+	unsigned int width, height;	/* Pixels in the raw RGBA file. */
+	char path[SIZEOF_STR];
+	const char *label;
+};
+
+static struct {
+	struct view *view;		/* The stage view showing an image, or NULL. */
+	struct image_panel panels[2];	/* Old, then new. */
+	bool has_mask;
+	bool skipped;			/* The helper found no image, which is no news. */
+	char note[SIZEOF_STR];
+	char error[SIZEOF_STR];
+	size_t label_line;		/* The label row; the image rows follow it. */
+	int rows;
+	int placed_columns;		/* Panel width in cells at the last placement. */
+} image_diff;
+
+static unsigned int image_ids[2];
+static short image_pairs[2];
+static int image_opacity = 50;
+static char image_cache_dir[SIZEOF_STR];
+static pid_t image_owner_pid;
+static int image_tmux_layers;
+
+static size_t
+image_encode_utf8(unsigned int codepoint, char *out)
+{
+	if (codepoint < 0x80) {
+		out[0] = codepoint;
+		return 1;
+	}
+	if (codepoint < 0x800) {
+		out[0] = 0xc0 | (codepoint >> 6);
+		out[1] = 0x80 | (codepoint & 0x3f);
+		return 2;
+	}
+	if (codepoint < 0x10000) {
+		out[0] = 0xe0 | (codepoint >> 12);
+		out[1] = 0x80 | ((codepoint >> 6) & 0x3f);
+		out[2] = 0x80 | (codepoint & 0x3f);
+		return 3;
+	}
+	out[0] = 0xf0 | (codepoint >> 18);
+	out[1] = 0x80 | ((codepoint >> 12) & 0x3f);
+	out[2] = 0x80 | ((codepoint >> 6) & 0x3f);
+	out[3] = 0x80 | (codepoint & 0x3f);
+	return 4;
+}
+
+static void
+image_base64(const char *input, char *output, size_t output_size)
+{
+	static const char alphabet[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+	size_t length = strlen(input), in = 0, out = 0;
+
+	while (in < length && out + 5 < output_size) {
+		unsigned int chunk = (unsigned char) input[in] << 16;
+		size_t available = MIN(length - in, 3);
+
+		if (available > 1)
+			chunk |= (unsigned char) input[in + 1] << 8;
+		if (available > 2)
+			chunk |= (unsigned char) input[in + 2];
+
+		output[out++] = alphabet[(chunk >> 18) & 0x3f];
+		output[out++] = alphabet[(chunk >> 12) & 0x3f];
+		output[out++] = available > 1 ? alphabet[(chunk >> 6) & 0x3f] : '=';
+		output[out++] = available > 2 ? alphabet[chunk & 0x3f] : '=';
+		in += 3;
+	}
+	output[out] = 0;
+}
+
+/* Counts the tmux servers a graphics command crosses on its way to the terminal.
+ * The client showing this pane adds one when it runs inside tmux itself, as a client attached from a tmux popup does.
+ * Nothing links a popup to the client that shows it, so nesting deeper than that is not followed. */
+static int
+image_count_tmux_layers(void)
+{
+	const char *tmux = getenv("TMUX");
+	const char *pane = getenv("TMUX_PANE");
+	const char *argv[] = { "tmux", "display-message", "-p", "-t", pane, "#{client_pid}", NULL };
+	char client_pid[SIZEOF_STR];
+	char environment_path[SIZEOF_STR];
+	char *entry = NULL;
+	size_t entry_size = 0;
+	int layers = 1;
+	FILE *file;
+
+	if (!tmux || !*tmux)
+		return 0;
+	if (!pane || !*pane || !io_run_buf(argv, client_pid, sizeof(client_pid), NULL, false) ||
+	    !string_format(environment_path, "/proc/%s/environ", client_pid) ||
+	    !(file = fopen(environment_path, "r")))
+		return layers;
+
+	while (getdelim(&entry, &entry_size, '\0', file) > 0)
+		if (!prefixcmp(entry, "TMUX=") && entry[STRING_SIZE("TMUX=")])
+			layers = 2;
+	free(entry);
+	fclose(file);
+	return layers;
+}
+
+/* Writes a graphics command to the terminal at once.
+ * putp would leave it in stdio's buffer until the next newline; curses empties its own buffer after every screen update,
+ * so the command still lands in order with the screen. */
+static void
+image_send(const char *command)
+{
+	FILE *output = get_display_output();
+	char sequence[SIZEOF_STR * 4], wrapped[SIZEOF_STR * 4];
+	int layer;
+
+	if (!output || !string_format(sequence, "\033_G%s\033\\", command))
+		return;
+
+	/* tmux drops escape sequences it does not know, and each tmux layer unwraps one passthrough: ESC P tmux; ... ESC \,
+	 * with every ESC inside doubled. */
+	for (layer = 0; layer < image_tmux_layers; layer++) {
+		size_t in, out = STRING_SIZE("\033Ptmux;");
+
+		memcpy(wrapped, "\033Ptmux;", out);
+		for (in = 0; sequence[in]; in++) {
+			if (out + 4 >= sizeof(wrapped))
+				return;
+			if (sequence[in] == '\033')
+				wrapped[out++] = '\033';
+			wrapped[out++] = sequence[in];
+		}
+		memcpy(wrapped + out, "\033\\", 3);
+		string_copy(sequence, wrapped);
+	}
+
+	fputs(sequence, output);
+	fflush(output);
+}
+
+/* q=2 keeps the terminal from answering, since an answer would arrive as keyboard input. */
+static void
+image_transmit(int index, int columns)
+{
+	struct image_panel *panel = &image_diff.panels[index];
+	char path[SIZEOF_STR * 2];
+	char command[SIZEOF_STR * 3];
+
+	image_base64(panel->path, path, sizeof(path));
+	string_format(command, "a=T,U=1,q=2,f=32,t=f,s=%u,v=%u,i=%u,p=1,c=%d,r=%d;%s",
+		      panel->width, panel->height, image_ids[index], columns, image_diff.rows, path);
+	image_send(command);
+}
+
+static void
+image_place(int index, int columns)
+{
+	char command[SIZEOF_STR];
+
+	string_format(command, "a=p,U=1,q=2,i=%u,p=1,c=%d,r=%d", image_ids[index], columns, image_diff.rows);
+	image_send(command);
+}
+
+static int
+image_panel_columns(struct view *view)
+{
+	bool both = image_diff.panels[0].present && image_diff.panels[1].present;
+	int width = getmaxx(view->win);
+	int columns = both ? (width - IMAGE_GAP) / 2 : width;
+
+	return MIN(MAX(columns, 1), IMAGE_MAX_CELLS);
+}
+
+/* A lone panel starts at the left edge, whichever side it is. */
+static int
+image_panel_x(int index, int columns)
+{
+	return index == 1 && image_diff.panels[0].present ? columns + IMAGE_GAP : 0;
+}
+
+static const char *
+image_cache(void)
+{
+	if (!*image_cache_dir) {
+		const char *runtime = getenv("XDG_RUNTIME_DIR");
+		char parent[SIZEOF_STR], lock_path[SIZEOF_STR];
+		int lock_fd;
+
+		if (!runtime || !*runtime)
+			runtime = get_temp_dir();
+		string_format(parent, "%s/tig-image-diff", runtime);
+		string_format(image_cache_dir, "%s/%d", parent, (int) getpid());
+
+		/* Held until tig exits and never closed, so the helper can sweep the caches of tig processes that died.
+		 * Close-on-exec keeps the helper and git from holding it on after tig is gone. */
+		if (string_format(lock_path, "%s.lock", image_cache_dir) &&
+		    (mkdir(parent, 0700) == 0 || errno == EEXIST) &&
+		    (lock_fd = open(lock_path, O_RDWR | O_CREAT | O_CLOEXEC, 0600)) >= 0)
+			flock(lock_fd, LOCK_EX);
+	}
+	return image_cache_dir;
+}
+
+static enum status_code
+image_read_fact(char *name, size_t namelen, char *value, size_t valuelen, void *data)
+{
+	int index = !strcmp(name, "old") ? 0 : !strcmp(name, "new") ? 1 : -1;
+
+	if (index >= 0) {
+		struct image_panel *panel = &image_diff.panels[index];
+		int offset = 0;
+
+		if (sscanf(value, "%u %u %n", &panel->width, &panel->height, &offset) == 2 && offset > 0) {
+			string_ncopy(panel->path, value + offset, strlen(value + offset));
+			panel->present = true;
+		}
+	} else if (!strcmp(name, "mask")) {
+		image_diff.has_mask = true;
+	} else if (!strcmp(name, "note")) {
+		string_ncopy(image_diff.note, value, valuelen);
+	} else if (!strcmp(name, "skip")) {
+		image_diff.skipped = true;
+	} else if (!strcmp(name, "error")) {
+		string_ncopy(image_diff.error, value, valuelen);
+	}
+
+	return SUCCESS;
+}
+
+static bool
+image_run_helper(const char *argv[])
+{
+	struct io io;
+
+	image_diff.error[0] = 0;
+	image_diff.skipped = false;
+	if (!io_run(&io, IO_RD, repo.exec_dir, NULL, argv)) {
+		string_format(image_diff.error, "cannot run %s", opt_image_diff_bin);
+		return false;
+	}
+	if (io_load(&io, " ", image_read_fact, NULL) != SUCCESS && !*image_diff.error && !image_diff.skipped)
+		string_copy(image_diff.error, "the helper failed");
+
+	return !*image_diff.error && !image_diff.skipped;
+}
+
+static bool
+image_init_ids(void)
+{
+	static bool initialized;
+	struct line_info *info;
+	int top, index;
+
+	if (initialized)
+		return true;
+
+	/* The id's low byte is a 256-color palette index. */
+	if (COLORS < 256)
+		return false;
+
+	/* Random ids, because every tmux pane shares one terminal screen and its images. */
+	srand(time(NULL) ^ getpid());
+	image_ids[0] = 16 + rand() % 240;
+	do {
+		image_ids[1] = 16 + rand() % 240;
+	} while (image_ids[1] == image_ids[0]);
+	for (index = 0; index < 2; index++)
+		image_ids[index] |= (unsigned int) (1 + rand() % 255) << 24;
+
+	/* Pairs at the top of the range stay clear of the ones tig allocates upwards from 1. */
+	top = MIN(COLOR_PAIRS, 32768) - 1;
+	info = get_line_info(NULL, LINE_DEFAULT);
+	for (index = 0; index < 2; index++) {
+		image_pairs[index] = top - index;
+		if (init_pair(image_pairs[index], image_ids[index] & 0xff, info->bg) == ERR)
+			return false;
+	}
+
+	initialized = true;
+	return true;
+}
+
+static void
+image_diff_exit(void)
+{
+	const char *argv[] = { opt_image_diff_bin, "cleanup", "--cache", image_cache(), NULL };
+	char command[SIZEOF_STR];
+	int index;
+
+	/* Children that fail to start a program exit through here too; only tig itself cleans up. */
+	if (getpid() != image_owner_pid)
+		return;
+
+	/* Sent before done_display's endwin leaves the alternate screen the images live on. */
+	for (index = 0; index < 2; index++) {
+		string_format(command, "a=d,d=I,q=2,i=%u", image_ids[index]);
+		image_send(command);
+	}
+	io_run_bg(argv, NULL);
+}
+
+static void
+image_report(void)
+{
+	if (image_diff.has_mask)
+		report("%s · highlight %d%%", image_diff.note, image_opacity);
+	else
+		report("%s", image_diff.note);
+}
+
+/* Git's own test: a NUL byte in the first 8000 bytes makes a file binary. */
+bool
+image_diff_is_binary_file(const char *name)
+{
+	char path[SIZEOF_STR];
+	char buf[8000];
+	FILE *file;
+	size_t size;
+
+	if (!opt_image_diff_bin || !*opt_image_diff_bin ||
+	    !string_format(path, "%s%s", repo.exec_dir, name) ||
+	    !(file = fopen(path, "rb")))
+		return false;
+
+	size = fread(buf, 1, sizeof(buf), file);
+	fclose(file);
+	return memchr(buf, 0, size) != NULL;
+}
+
+/* Git prints "Binary files ... differ" for a binary file and the pointer text for a Git LFS file. */
+bool
+image_diff_is_binary_diff(struct view *view)
+{
+	size_t index;
+
+	if (!opt_image_diff_bin || !*opt_image_diff_bin)
+		return false;
+
+	for (index = 0; index < view->lines; index++) {
+		const char *text;
+
+		if (!view->line[index].data)
+			continue;
+		text = box_text(&view->line[index]);
+		if (!prefixcmp(text, "Binary files ") ||
+		    strstr(text, "version https://git-lfs.github.com/spec/v1"))
+			return true;
+	}
+
+	return false;
+}
+
+void
+image_diff_reset(void)
+{
+	image_diff.view = NULL;
+}
+
+bool
+image_diff_active(struct view *view)
+{
+	return image_diff.view == view && image_diff.label_line < view->lines &&
+	       view->line[image_diff.label_line].type == LINE_IMAGE_DIFF;
+}
+
+bool
+image_diff_load(struct view *view, const struct status *status, enum line_type stage_type)
+{
+	const char *old_revision = status->old.rev;
+	const char *new_revision = status->new.rev;
+	const char *old_path = *status->old.name ? status->old.name : status->new.name;
+	char opacity[8];
+	const char *argv[] = {
+		opt_image_diff_bin, "prepare", "--cache", image_cache(),
+		"--path", status->new.name, "--old-path", old_path,
+		"--old", NULL, "--new", NULL, "--opacity", opacity, NULL
+	};
+	int columns, height, index, row;
+
+	if (!opt_image_diff_bin || !*opt_image_diff_bin || status->status == 'U')
+		return false;
+
+	memset(&image_diff, 0, sizeof(image_diff));
+	switch (stage_type) {
+	case LINE_STAT_STAGED:
+		image_diff.panels[0].label = "old (HEAD)";
+		image_diff.panels[1].label = "new (index)";
+		break;
+
+	case LINE_STAT_UNSTAGED:
+		image_diff.panels[0].label = "old (index)";
+		image_diff.panels[1].label = "new (working tree)";
+		new_revision = "worktree";
+		break;
+
+	case LINE_STAT_UNTRACKED:
+		image_diff.panels[1].label = "new (untracked)";
+		old_revision = NULL_ID;
+		new_revision = "worktree";
+		break;
+
+	default:
+		return false;
+	}
+
+	argv[9] = old_revision;
+	argv[11] = new_revision;
+	image_tmux_layers = image_count_tmux_layers();
+	string_format(opacity, "%d", image_opacity);
+
+	if (!image_run_helper(argv) || !(image_diff.panels[0].present || image_diff.panels[1].present)) {
+		if (!image_diff.skipped)
+			report("Image diff: %s", *image_diff.error ? image_diff.error : "the helper printed no image");
+		return false;
+	}
+
+	if (!image_init_ids()) {
+		report("Image diff needs a terminal with 256 colors");
+		return false;
+	}
+
+	/* Fit the image under the diff text when there is room, else give it the whole view and let it scroll. */
+	height = view->height > 1 ? view->height : LINES - 2;
+	image_diff.rows = height - 1 - (int) view->lines;
+	if (image_diff.rows < IMAGE_MIN_ROWS)
+		image_diff.rows = height - 1;
+	image_diff.rows = MIN(MAX(image_diff.rows, 1), IMAGE_MAX_CELLS);
+
+	columns = image_panel_columns(view);
+	for (index = 0; index < 2; index++)
+		if (image_diff.panels[index].present)
+			image_transmit(index, columns);
+	image_diff.placed_columns = columns;
+
+	if (!image_owner_pid && !atexit(image_diff_exit))
+		image_owner_pid = getpid();
+
+	image_diff.label_line = view->lines;
+	for (row = 0; row <= image_diff.rows; row++)
+		if (!add_line_text(view, "", LINE_IMAGE_DIFF))
+			return false;
+
+	image_diff.view = view;
+	image_report();
+	return true;
+}
+
+void
+image_diff_adjust(int direction)
+{
+	int opacity = MIN(MAX(image_opacity + direction * IMAGE_OPACITY_STEP, 0), 100);
+	char opacity_arg[8];
+	const char *argv[] = { opt_image_diff_bin, "tint", "--cache", image_cache(), "--opacity", opacity_arg, NULL };
+
+	if (!image_diff.has_mask) {
+		report("%s · nothing to highlight", image_diff.note);
+		return;
+	}
+
+	if (opacity != image_opacity) {
+		string_format(opacity_arg, "%d", opacity);
+		if (!image_run_helper(argv)) {
+			report("Image diff: %s", image_diff.error);
+			return;
+		}
+		image_opacity = opacity;
+		image_transmit(1, image_diff.placed_columns);
+	}
+
+	image_report();
+}
+
+static void
+image_draw_cells(struct view *view, unsigned int lineno, int index, int row, int columns)
+{
+	char cells[IMAGE_MAX_CELLS * 16];
+	char row_mark[4], high_mark[4];
+	size_t row_size = image_encode_utf8(image_marks[row], row_mark);
+	size_t high_size = image_encode_utf8(image_marks[image_ids[index] >> 24], high_mark);
+	size_t size = 0;
+	int column;
+
+	for (column = 0; column < columns; column++) {
+		memcpy(cells + size, IMAGE_PLACEHOLDER, STRING_SIZE(IMAGE_PLACEHOLDER));
+		size += STRING_SIZE(IMAGE_PLACEHOLDER);
+		memcpy(cells + size, row_mark, row_size);
+		size += row_size;
+		size += image_encode_utf8(image_marks[column], cells + size);
+		memcpy(cells + size, high_mark, high_size);
+		size += high_size;
+	}
+
+	wattr_set(view->win, A_NORMAL, image_pairs[index], NULL);
+	mvwaddnstr(view->win, lineno, image_panel_x(index, columns), cells, size);
+}
+
+bool
+image_diff_draw(struct view *view, struct line *line, unsigned int lineno)
+{
+	size_t line_index = line - view->line;
+	int width = getmaxx(view->win);
+	int columns, index, row;
+
+	wmove(view->win, lineno, 0);
+	wclrtoeol(view->win);
+
+	if (!image_diff_active(view) || line_index < image_diff.label_line)
+		return true;
+
+	columns = image_panel_columns(view);
+	if (columns != image_diff.placed_columns) {
+		for (index = 0; index < 2; index++)
+			if (image_diff.panels[index].present)
+				image_place(index, columns);
+		image_diff.placed_columns = columns;
+	}
+
+	/* The cursor shows as a bar under the labels, or around the panels on an image row. */
+	if (line->selected) {
+		for (index = 0; index < width; index++)
+			waddch(view->win, ' ');
+	} else {
+		(void) wattrset(view->win, get_view_attr(view, LINE_IMAGE_DIFF));
+	}
+
+	if (line_index == image_diff.label_line) {
+		for (index = 0; index < 2; index++)
+			if (image_diff.panels[index].present)
+				mvwaddnstr(view->win, lineno, image_panel_x(index, columns),
+					   image_diff.panels[index].label, columns);
+		return true;
+	}
+
+	row = line_index - image_diff.label_line - 1;
+	if (row < image_diff.rows) {
+		for (index = 0; index < 2; index++)
+			if (image_diff.panels[index].present)
+				image_draw_cells(view, lineno, index, row, columns);
+		wattr_set(view->win, A_NORMAL, 0, NULL);
+	}
+
+	return true;
+}
